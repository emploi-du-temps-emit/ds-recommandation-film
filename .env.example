# ============================================
# Movie Recommender - Variables d'environnement
# ============================================

# --- Base de donnees ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_recommender
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- TMDB (Posters de films) ---
# Obtenez un token gratuit sur https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=votre-jeton-d-acces-lecture-api-ici

# --- Securite ---
SECRET_KEY=changez-moi-en-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
